{
  "schemaVersion": "tutti.agent.manifest.v2",
  "agentKey": "kimi-code",
  "version": "1.0.7",
  "name": "Kimi Code",
  "description": "Kimi Code through the standard Agent Client Protocol",
  "icon": { "type": "asset", "src": "assets/icon.png" },
  "heroImage": { "type": "asset", "src": "assets/hero-image.jpg" },
  "runtime": {
    "kind": "standard-acp",
    "install": {
      "runner": "npm",
      "args": ["install", "--prefix", "${installRoot}", "@moonshot-ai/kimi-code@0.28.0"]
    },
    "launch": {
      "executable": "${installRoot}/node_modules/.bin/kimi",
      "args": ["acp"]
    }
  },
  "profiles": {
    "discovery": "profiles/discovery.json",
    "tools": "profiles/tools.json",
    "capabilities": "profiles/capabilities.json",
    "composer": "profiles/composer.json",
    "authentication": "profiles/authentication.json"
  },
  "localizationInfo": {
    "defaultLocale": "en",
    "defaultFile": "locales/en.json",
    "additionalLocales": [{ "locale": "zh-CN", "file": "locales/zh-CN.json" }]
  }
}
